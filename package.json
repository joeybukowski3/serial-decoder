{
  "name": "serial-decoder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:decoders && npm run build:browser && npm run build:smart-browser && npm run build:inject",
    "dev": "npx vercel dev",
    "test": "npm run test:decoder && npm run test:unit && npm run test:api",
    "refresh-pricebook": "node scripts/refresh-pricebook.js",
    "build:decoders": "node scripts/split-decoder-data.js",
    "build:browser": "node scripts/build-serial-refinement-browser.js",
    "build:seo": "npm run build:decoders && node scripts/generate-seo-pages.js",
    "build:inject": "node scripts/inject-serial-refinement-script.js && node scripts/inject-responsive-navigation-assets.js",
    "test:decoder": "node tests/decoder-regressions.test.mjs",
    "test:unit": "node --test tests/refinement/*.test.mjs tests/lib/*.test.mjs tests/analytics/*.test.mjs tests/upsell/*.test.mjs",
    "test:api": "node --test tests/api/*.test.mjs",
    "test:playwright": "npx playwright test tests/playwright-verify.spec.js tests/serial-refinement-ui.spec.js tests/electronics-page-quality.spec.js tests/generated-brand-quality.spec.js tests/adsense-final-readiness.spec.js",
    "build:smart-browser": "node scripts/build-smart-lookup-browser.js",
    "test:smart-unit": "node --test tests/smart-lookup/*.test.mjs",
    "test:smart-api": "node --test tests/api/smart-lookup-*.test.mjs",
    "test:smart-benchmark": "node --test tests/benchmarks/smart-lookup-benchmark.test.mjs",
    "test:vizio-benchmark": "node --test tests/benchmarks/vizio-generation-benchmark.test.mjs",
    "test:smart-playwright": "npx playwright test -c tests/smart-lookup-playwright.config.mjs"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "clean-css-cli": "^5.6.3",
    "terser": "^5.48.0"
  }
}
